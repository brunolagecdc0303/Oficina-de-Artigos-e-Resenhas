---
const {
  olho = "Próximo passo",
  titulo = "O diagnóstico vem antes da recomendação",
  texto = "Sete perguntas e três minutos. Você sai com um retrato dos seus riscos priorizados, e eu chego na nossa conversa já preparado.",
  botao = "Fazer o diagnóstico",
  href = "/diagnostico",
} = Astro.props;
---
<section class="secao secao-linha nao-imprime">
  <div class="wrap wrap-estreito" style="text-align:center">
    <p class="olho" style="justify-content:center">{olho}</p>
    <h2>{titulo}</h2>
    <p class="lead" style="margin-inline:auto;max-width:56ch">{texto}</p>
    <p style="margin-top:1.8rem"><a class="btn btn-primario" href={href}>{botao}</a></p>
  </div>
</section>
