---
import { SITE, DISCLAIMER_CURTO, DISCLAIMER_INSTITUCIONAL } from "../lib/site.js";
const ano = new Date().getFullYear();
---
<footer class="rodape nao-imprime">
  <div class="wrap">
    <div class="rodape-grade">
      <div>
        <p class="marca" style="font-size:1.1rem;margin-bottom:.6rem">{SITE.marcaCurta}</p>
        <p class="pequeno" style="color:var(--muted);max-width:34ch">
          Diagnóstico patrimonial em oito dimensões, plano de uma página e
          transparência total de remuneração.
        </p>
        <p style="margin-top:1.2rem">
          <a class="btn btn-secundario pequeno" href="/diagnostico">Fazer o diagnóstico</a>
        </p>
      </div>

      <div>
        <h4>Navegar</h4>
        <ul>
          <li><a href="/como-trabalho">Como eu trabalho</a></li>
          <li><a href="/para-quem">Para quem é</a></li>
          <li><a href="/o-que-nao-faco">O que eu não faço</a></li>
          <li><a href="/remuneracao">Como sou remunerado</a></li>
          <li><a href="/valor-do-assessor">De onde vem o valor</a></li>
          <li><a href="/sobre">Sobre</a></li>
        </ul>
      </div>

      <div>
        <h4>Ferramentas</h4>
        <ul>
          <li><a href="/calculadoras">Calculadoras</a></li>
          <li><a href="/artigos">Artigos</a></li>
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href="/privacidade">Privacidade e LGPD</a></li>
          <li><a href="/admin">Administração</a></li>
        </ul>
      </div>
    </div>

    <div class="legal">
      <p>
        <strong>{SITE.profissional.nome}</strong>, {SITE.profissional.cargo}
        {SITE.profissional.certificacoes.length > 0 && ` · ${SITE.profissional.certificacoes.join(" · ")}`}
        {" "}· {SITE.profissional.cidade}.
      </p>
      <p>{DISCLAIMER_INSTITUCIONAL}</p>
      <p>
        {DISCLAIMER_CURTO} Este site tem finalidade exclusivamente informativa e
        educacional. Nenhum conteúdo aqui constitui oferta ou recomendação
        individualizada. As calculadoras são simulações ilustrativas a partir de
        premissas do próprio usuário e não representam promessa ou sugestão de
        rentabilidade. Sobre arranjos de remuneração, veja
        <a href="/remuneracao">Como sou remunerado</a>.
      </p>
      <p>© {ano} {SITE.marcaCurta}. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
