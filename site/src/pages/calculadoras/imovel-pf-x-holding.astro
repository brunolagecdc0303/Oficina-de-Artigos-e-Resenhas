---
import Calculadora from "../../layouts/Calculadora.astro";
---
<Calculadora slug="imovel-pf-x-holding" vigencia="tabela progressiva do IRPF e regime de lucro presumido para locação, confirme com seu contador">
  <form id="f" class="calc-painel" slot="entradas">
    <label class="campo"><span>Receita mensal de aluguéis (R$)</span>
      <input id="aluguel" type="number" value="45000" min="0" step="1000" /></label>
    <label class="campo"><span>Valor de mercado dos imóveis (R$)</span>
      <input id="valorImoveis" type="number" value="6000000" min="0" step="100000" /></label>
    <label class="campo"><span>Outra renda tributável mensal da pessoa física (R$)</span>
      <input id="outraRenda" type="number" value="0" min="0" step="1000" />
      <span class="ajuda">O aluguel entra no carnê-leão e soma com o resto da sua renda. Quanto maior ela, mais caro fica o aluguel na PF.</span></label>

    <hr style="margin:1.5rem 0" />
    <p class="olho">A holding</p>
    <label class="campo"><span>Presunção de lucro sobre locação (%)</span>
      <input id="presuncao" type="number" value="32" step="1" />
      <span class="ajuda">Trinta e dois por cento é a presunção usual quando a locação é a atividade da empresa. Há entendimento de 8% em casos específicos, pergunte ao seu contador qual é o seu.</span></label>
    <label class="campo"><span>Custo anual de manutenção da holding (R$)</span>
      <input id="custoHolding" type="number" value="24000" min="0" step="2000" />
      <span class="ajuda">Contabilidade, obrigações acessórias e honorários recorrentes.</span></label>
    <label class="campo"><span>Custo de constituição e integralização (R$)</span>
      <input id="custoConstituicao" type="number" value="80000" min="0" step="10000" />
      <span class="ajuda">Advogado, ITBI sobre o que exceder o capital social, cartório, registro.</span></label>
    <label class="campo"><span>Horizonte da análise (anos)</span>
      <input id="anos" type="number" value="10" min="1" max="30" /></label>

    <hr style="margin:1.5rem 0" />
    <label class="campo"><span>Alíquota sobre dividendos (%)</span>
      <input id="aliqDiv" type="number" value="10" step="0.5" /></label>
    <label class="campo"><span>Isenção mensal de dividendos (R$)</span>
      <input id="isencaoDiv" type="number" value="50000" min="0" step="5000" /></label>
  </form>

  <div slot="saida">
    <div class="resultado">
      <div class="rotulo" id="r-rotulo">Economia anual líquida da holding</div>
      <div class="valor num" id="r-valor">—</div>
      <p class="frase" id="r-frase"></p>
    </div>
    <div id="r-barras" class="barras"></div>
    <dl id="r-linhas" class="linhas" style="margin:0"></dl>
  </div>

  <section class="secao secao-linha" slot="depois">
    <div class="wrap wrap-estreito">
      <h2>Holding não é blindagem</h2>
      <p>
        Esta calculadora responde a uma pergunta só: a economia tributária paga o
        custo da estrutura? É a pergunta menos importante das três.
      </p>
      <p>
        As outras duas são sucessórias, a holding facilita a partilha, permite
        doação de quotas em vida com reserva de usufruto e evita que cada imóvel
        vire um processo, e societárias, porque o acordo entre herdeiros pode
        ser escrito antes do conflito, não durante. Uma holding que só se paga no
        imposto costuma ser uma holding mal justificada.
      </p>
      <p>
        E vale dizer o que ela não faz: holding não protege patrimônio de dívida
        legítima, não esconde bens e não substitui seguro. Quem vende holding
        como blindagem está vendendo outra coisa.
      </p>
    </div>
  </section>
</Calculadora>

<script>
  import { irpfMensal, moeda, percentual, anosEMeses } from "../../lib/financas.js";
  import { IRPF_MENSAL, PJ_PRESUMIDO } from "../../lib/tabelas.js";
  import { num, pct, ligar, definir, linhas, barras } from "../../lib/ui.js";

  function calcular() {
    const aluguel = num("aluguel");
    const outraRenda = num("outraRenda");
    const anos = Math.max(1, num("anos", 10));

    // Pessoa física: o aluguel soma à renda e sobe pela tabela progressiva.
    const irComAluguel = irpfMensal(outraRenda + aluguel, IRPF_MENSAL);
    const irSemAluguel = irpfMensal(outraRenda, IRPF_MENSAL);
    const impostoPf = (irComAluguel - irSemAluguel) * 12;

    // Holding no lucro presumido.
    const receitaAnual = aluguel * 12;
    const basePresumida = receitaAnual * pct("presuncao", 0.32);
    const irpj =
      basePresumida * PJ_PRESUMIDO.irpj +
      Math.max(0, basePresumida - PJ_PRESUMIDO.limiteAdicionalMensal * 12) * PJ_PRESUMIDO.adicionalIrpj;
    const csll = receitaAnual * PJ_PRESUMIDO.presuncaoCsll * PJ_PRESUMIDO.csll;
    const pisCofins = receitaAnual * (PJ_PRESUMIDO.pis + PJ_PRESUMIDO.cofins);
    const custoHolding = num("custoHolding");
    const lucroDistribuivel = Math.max(0, receitaAnual - irpj - csll - pisCofins - custoHolding);
    const baseDiv = Math.max(0, lucroDistribuivel - num("isencaoDiv", 50000) * 12);
    const irDividendos = baseDiv * pct("aliqDiv", 0.1);
    const impostoPj = irpj + csll + pisCofins + irDividendos;

    const liquidoPf = receitaAnual - impostoPf;
    const liquidoPj = receitaAnual - impostoPj - custoHolding;
    const economiaAnual = liquidoPj - liquidoPf;

    const custoConstituicao = num("custoConstituicao");
    const payback = economiaAnual > 0 ? (custoConstituicao / economiaAnual) * 12 : Infinity;
    const ganhoPeriodo = economiaAnual * anos - custoConstituicao;

    definir("r-rotulo", economiaAnual >= 0 ? "Economia anual líquida da holding" : "Custo anual extra da holding");
    definir("r-valor", moeda(Math.abs(economiaAnual)));
    definir(
      "r-frase",
      economiaAnual <= 0
        ? `Neste cenário a holding sai mais cara que a pessoa física. Isso não a descarta, a justificativa dela pode ser sucessória e societária, mas descarta o argumento tributário, que costuma ser o único apresentado na venda.`
        : payback > anos * 12
        ? `A economia existe, mas os ${moeda(custoConstituicao)} de constituição levariam ${anosEMeses(payback)} para se pagar, mais do que o horizonte de ${anos} anos que você definiu. Só por imposto, não fecha.`
        : `Os ${moeda(custoConstituicao)} de constituição se pagam em ${anosEMeses(payback)}. Em ${anos} anos, o ganho acumulado é de ${moeda(ganhoPeriodo)}, já descontado tudo.`
    );

    barras("r-barras", [
      { rotulo: "Líquido na pessoa física", valor: liquidoPf, texto: moeda(liquidoPf), tom: economiaAnual > 0 ? "" : "ok" },
      { rotulo: "Líquido na holding", valor: liquidoPj, texto: moeda(liquidoPj), tom: economiaAnual > 0 ? "ok" : "" },
    ]);

    linhas("r-linhas", [
      { rotulo: "Receita anual de aluguéis", valor: moeda(receitaAnual) },
      { rotulo: "IRPF sobre o aluguel na pessoa física", valor: moeda(impostoPf), destaque: true },
      { rotulo: "Alíquota efetiva na pessoa física", valor: percentual(impostoPf / receitaAnual, 1) },
      { rotulo: "IRPJ e adicional na holding", valor: moeda(irpj) },
      { rotulo: "CSLL", valor: moeda(csll) },
      { rotulo: "PIS e COFINS", valor: moeda(pisCofins) },
      { rotulo: "IR sobre dividendos distribuídos", valor: moeda(irDividendos) },
      { rotulo: "Manutenção anual da holding", valor: moeda(custoHolding) },
      { rotulo: "Alíquota efetiva na holding", valor: percentual((impostoPj + custoHolding) / receitaAnual, 1), total: true },
      { rotulo: "Diferença anual", valor: moeda(economiaAnual), total: true, destaque: economiaAnual < 0 },
      { rotulo: "Tempo para pagar a constituição", valor: anosEMeses(payback), total: true },
    ]);
  }

  ligar("f", calcular);
</script>
