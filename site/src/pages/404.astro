---
import Base from "../layouts/Base.astro";
---
<Base titulo="Página não encontrada">
  <section class="secao">
    <div class="wrap wrap-estreito" style="text-align:center;padding-block:4rem">
      <p class="olho" style="justify-content:center">Erro 404</p>
      <h1>Essa página não existe</h1>
      <p class="lead">Talvez o endereço tenha mudado, ou o link esteja quebrado.</p>
      <p style="margin-top:2rem;display:flex;gap:.6rem;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-primario" href="/">Voltar ao início</a>
        <a class="btn btn-secundario" href="/calculadoras">Ver as calculadoras</a>
      </p>
    </div>
  </section>
</Base>
