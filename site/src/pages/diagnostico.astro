---
import Landing from "../layouts/Landing.astro";
import { SITE } from "../lib/site.js";
import { DIMENSOES } from "../lib/calculadoras.js";
import { getCollection } from "astro:content";
import { mesclarTextos } from "../lib/textos.js";

// Renderizada a cada visita, para pegar os textos editados no painel sem
// precisar de novo deploy. O resto do site continua estático.
export const prerender = false;

/** Lê os textos salvos. Se o armazenamento não responder, usa os padrões. */
async function carregarTextos() {
  try {
    const { getStore } = await import("@netlify/blobs");
    const salvos = await getStore("config-site").get("textos", { type: "json" });
    return mesclarTextos(salvos);
  } catch {
    return mesclarTextos(null);
  }
}
const t = await carregarTextos();

// O bloco de agradecimento só oferece o blog quando há artigo publicado.
const temArtigos = (await getCollection("artigos")).some((a) => !a.data.rascunho);

// A landing trabalha com as frentes que o visitante reconhece sozinho.
// O método completo, com as oito dimensões, está em /como-trabalho.
const FRENTES = ["fluxo", "investimentos", "tributaria", "protecao", "sucessoria", "internacional"];

// O que a pessoa leva para casa depois de enviar. São perguntas, não
// recomendações: apontam para onde olhar sem dizer o que fazer.
const perguntas = {
  fluxo:
    "Se a distribuição de lucros parasse amanhã e permanentemente, por quanto tempo o seu padrão de vida se sustentaria?",
  investimentos:
    "Pegue os cinco maiores ativos da sua carteira. Você consegue dizer, de cada um, qual objetivo ele serve e em que prazo?",
  tributaria:
    "Quanto você pagou de imposto sobre investimentos no último ano, e quanto disso seria evitável com o mesmo ativo em outro veículo?",
  protecao:
    "Se você não estivesse aqui amanhã, sua família teria dinheiro em conta para os próximos doze meses sem precisar vender nada?",
  sucessoria:
    "De onde sairia o dinheiro do ITCMD? Ele vence antes de a família ter acesso ao patrimônio que está sendo inventariado.",
  internacional:
    "Seus ativos nos Estados Unidos estão em conta direta? Acima de US$ 60 mil, isso expõe a família a imposto americano que chega a 40%.",
};

// Nome legível de cada frente, para montar o retorno no navegador.
const nomesFrentes = Object.fromEntries(FRENTES.map((c) => [c, DIMENSOES[c].nome]));
const dimensoes = FRENTES.map((chave) => [chave, DIMENSOES[chave]]);
const sinais = {
  fluxo: "A renda sobe, o padrão sobe junto. Organizar é o que faz gastar certo.",
  investimentos: "A famosa carteira colcha de retalhos: vários ativos, nenhum com objetivo definido.",
  tributaria: "Não aproveita as poucas concessões que o governo dá.",
  protecao: "Quase ninguém pensa nisso. É uma ponta solta barata demais para ficar solta.",
  sucessoria: "Sem organização e sem instrumento formal, vira briga de família.",
  internacional: "Ou não tem, ou está feito errado: sem estrutura fiscal e sem proteção.",
};

---
<Landing
  titulo="Diagnóstico patrimonial"
  descricao="Antes de falar de produto, entender onde o seu patrimônio está exposto. Sete perguntas, três minutos."
>
  <!-- Tensão -->
  <section class="secao" style="padding-bottom:0">
    <div class="wrap wrap-estreito">
      <p class="olho">{t.heroOlho}</p>
      <h1>{t.heroTitulo}</h1>
      <p class="lead">{t.heroParagrafo1}</p>
      <p class="lead">{t.heroParagrafo2}</p>
      <p style="margin-top:2rem;display:flex;gap:.7rem;flex-wrap:wrap;align-items:center">
        <a class="btn btn-primario" href="#formulario">{t.heroBotao}</a>
        <span class="nota" style="margin:0">{t.heroNota}</span>
      </p>
    </div>
  </section>

  <!-- Custo -->
  <section class="secao">
    <div class="wrap wrap-estreito">
      <h2>{t.custoTitulo}</h2>
      <p>{t.custoParagrafo}</p>
      <div class="grade grade-2" style="margin-top:2rem">
        {dimensoes.map(([chave, dim]) => (
          <div class="cartao">
            <p class="etiqueta" style={`--dim: var(--${dim.cor})`}>{dim.nome}</p>
            <p class="pequeno" style="margin:.6rem 0 0;color:var(--ink-2)">{sinais[chave]}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mecanismo -->
  <section class="secao secao-linha">
    <div class="wrap wrap-estreito">
      <p class="olho">Como funciona</p>
      <h2>{t.metodoTitulo}</h2>
      <p>{t.metodoParagrafo}</p>

      <ol class="empilha" style="--gap:1rem;list-style:none;padding:0;margin:2rem 0 0;counter-reset:passo">
        {[
          { t: "Descoberta", d: "Noventa minutos. Eu pergunto e escuto, sobre a família, a empresa e o que te tira o sono. Em 48 horas você recebe por escrito o resumo do que eu entendi." },
          { t: "Coleta e análise", d: "Você me manda os documentos de uma lista objetiva. Eu mapeio cada frente e consolido tudo em um mapa patrimonial único." },
          { t: "Diagnóstico", d: "Sessenta minutos. Eu apresento o retrato atual com os riscos priorizados. Você sai sabendo exatamente onde está." },
          { t: "Plano", d: "Noventa minutos. Recomendações priorizadas e sequenciadas, com responsável e prazo, em uma página. Inclusive o que não vamos fazer, e por quê." },
          { t: "Decisão", d: "É aqui que você decide. Com o diagnóstico e o plano na mão, eu apresento a proposta: o que eu executo, como funciona o acompanhamento e quanto custa. Fechando, as primeiras ações saem com data na mesma semana." },
        ].map((p, i) => (
          <li class="cartao" style="display:flex;gap:1rem;align-items:flex-start">
            <span class="serif" style="font-size:1.6rem;color:var(--accent);line-height:1;min-width:1.5rem">{i + 1}</span>
            <span>
              <b style="display:block;margin-bottom:.25rem">{p.t}</b>
              <span class="pequeno" style="color:var(--ink-2)">{p.d}</span>
            </span>
          </li>
        ))}
      </ol>

      <p style="margin-top:2rem">{t.metodoFecho}</p>
    </div>
  </section>

  <!-- Formulário -->
  <section class="secao secao-linha" id="formulario">
    <div class="wrap wrap-estreito">
      <p class="olho">Começar</p>
      <h2>{t.formTitulo}</h2>
      <p class="lead">{t.formLead}</p>

      {t.fotoUrl && (
        <div class="cartao-autor">
          <img src={t.fotoUrl} alt={`Foto de ${SITE.profissional.nome}`} width="104" height="139" loading="lazy" />
          <div>
            <p class="cartao-autor-nome">{SITE.profissional.nome}</p>
            <p class="cartao-autor-cargo">
              {SITE.profissional.cargo}
              {SITE.profissional.certificacoes.length > 0 && ` · ${SITE.profissional.certificacoes.join(" · ")}`}
            </p>
            {t.fotoLegenda && <p class="cartao-autor-legenda">{t.fotoLegenda}</p>}
          </div>
        </div>
      )}

      <!--
        Formulário fantasma: a Netlify precisa enxergar um <form> com estes
        campos no HTML gerado para criar o canal de notificação. O envio real
        é feito por JavaScript, e este aqui nunca aparece para ninguém.
      -->
      <form name="diagnostico" data-netlify="true" netlify-honeypot="website" hidden>
        <input type="text" name="nome" />
        <input type="email" name="email" />
        <input type="tel" name="telefone" />
        <input type="text" name="perfil" />
        <input type="text" name="patrimonio" />
        <input type="text" name="prazo" />
        <input type="text" name="preocupacoes" />
        <textarea name="contexto"></textarea>
        <input type="text" name="origem" />
        <input type="text" name="faixa" />
        <input type="text" name="pontuacao" />
        <input type="text" name="website" />
      </form>

      <form id="form-lead" class="cartao" style="margin-top:2rem;padding:1.75rem">
        <div style="position:absolute;left:-9999px" aria-hidden="true">
          <label>Deixe em branco<input id="website" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="grade grade-2">
          <label class="campo"><span>Nome completo *</span>
            <input id="nome" type="text" required autocomplete="name" /></label>
          <label class="campo"><span>E-mail *</span>
            <input id="email" type="email" required autocomplete="email" /></label>
        </div>
        <label class="campo"><span>WhatsApp</span>
          <input id="telefone" type="tel" autocomplete="tel" placeholder="(31) 90000-0000" /></label>

        <fieldset style="border:0;padding:0;margin:1.5rem 0 1.1rem">
          <legend class="olho" style="padding:0">O que descreve melhor a sua situação</legend>
          <div class="escolhas">
            <label class="escolha"><input type="radio" name="perfil" value="empresario" required />
              <span><b>Sou empresário</b><small>O patrimônio e a empresa se confundem em algum grau</small></span></label>
            <label class="escolha"><input type="radio" name="perfil" value="medico-pj" />
              <span><b>Sou médico ou dentista com PJ</b><small>Renda alta, pouca estrutura e sucessão nunca tratada</small></span></label>
            <label class="escolha"><input type="radio" name="perfil" value="executivo" />
              <span><b>Sou executivo</b><small>Salário alto, participação, stock options, exposição internacional</small></span></label>
            <label class="escolha"><input type="radio" name="perfil" value="profissional-liberal" />
              <span><b>Sou profissional liberal</b><small>Advogado, engenheiro, consultor, arquiteto</small></span></label>
            <label class="escolha"><input type="radio" name="perfil" value="aposentado" />
              <span><b>Já parei de trabalhar</b><small>Vivo de renda e a prioridade é não errar</small></span></label>
            <label class="escolha"><input type="radio" name="perfil" value="outro" />
              <span><b>Outra situação</b></span></label>
          </div>
        </fieldset>

        <label class="campo"><span>Patrimônio investível, fora o imóvel onde você mora *</span>
          <select id="patrimonio" required>
            <option value="">Selecione</option>
            <option value="ate-500k">Até R$ 500 mil</option>
            <option value="500k-2mi">De R$ 500 mil a R$ 2 milhões</option>
            <option value="2mi-5mi">De R$ 2 a R$ 5 milhões</option>
            <option value="5mi-20mi">De R$ 5 a R$ 20 milhões</option>
            <option value="acima-20mi">Acima de R$ 20 milhões</option>
            <option value="prefiro-nao-dizer">Prefiro não dizer agora</option>
          </select>
</label>

        <fieldset style="border:0;padding:0;margin:1.5rem 0 1.1rem">
          <legend class="olho" style="padding:0">O que mais te preocupa hoje</legend>
          <p class="nota" style="margin:-.5rem 0 .8rem">Marque quantas quiser.</p>
          <div class="escolhas grade-2" style="display:grid">
            {dimensoes.map(([chave, dim]) => (
              <label class="escolha">
                <input type="checkbox" name="dimensoes" value={chave} />
                <span><b>{dim.nome}</b><small>{sinais[chave]}</small></span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="campo"><span>Quando você pretende resolver isso *</span>
          <select id="prazo" required>
            <option value="">Selecione</option>
            <option value="agora">Agora, já é um problema</option>
            <option value="3-meses">Nos próximos três meses</option>
            <option value="este-ano">Ainda este ano</option>
            <option value="pesquisando">Só estou me informando</option>
          </select></label>

        <label class="campo"><span>Tem algo que eu precise saber antes da conversa?</span>
          <textarea id="contexto" rows="4" placeholder="Uma venda de empresa em andamento, um divórcio, um sócio saindo, uma doença na família. O que for."></textarea></label>

        <label class="campo"><span>Como você chegou até aqui?</span>
          <input id="origem" type="text" placeholder="Indicação de alguém, artigo, evento, busca no Google" /></label>

        <label class="escolha" style="margin:1.5rem 0">
          <input id="consentimento" type="checkbox" required />
          <span><small>Autorizo o uso dos meus dados para retorno de contato sobre este pedido,
            conforme a <a href="/privacidade">política de privacidade</a>. Posso pedir a
            exclusão a qualquer momento.</small></span>
        </label>

        <button class="btn btn-primario btn-bloco" type="submit" id="btn-enviar">Enviar</button>
        <p class="nota" style="margin-top:.8rem;text-align:center">
          {t.formRodape}
        </p>
        <p id="erro-form" class="pequeno oculto" style="color:var(--alerta);margin-top:.8rem" role="alert"></p>
      </form>

      <div id="obrigado" class="cartao oculto" style="margin-top:2rem;padding:2rem">
        <p class="olho">Recebido</p>
        <h2 id="obrigado-titulo" style="margin-bottom:.5rem"></h2>
        <p id="obrigado-msg" class="lead"></p>
        <div id="obrigado-perguntas" class="oculto" style="margin-top:1.75rem"></div>
        <p id="obrigado-acoes" style="margin-top:1.5rem;display:flex;gap:.6rem;flex-wrap:wrap"></p>
      </div>
    </div>
  </section>
</Landing>

<style>
  .cartao-autor {
    display: flex; gap: 1rem; align-items: center;
    border: 1px solid var(--line); border-radius: var(--r);
    background: var(--surface); padding: 1rem 1.15rem; margin-top: 1.75rem;
  }
  .cartao-autor img {
    width: 104px; height: auto; aspect-ratio: 3 / 4;
    border-radius: var(--r-sm); object-fit: cover; object-position: center;
    flex: none; border: 1px solid var(--line-forte);
  }
  @media (max-width: 420px) {
    .cartao-autor { flex-direction: column; align-items: flex-start; }
    .cartao-autor img { width: 88px; }
  }
  .cartao-autor-nome { font-family: var(--serif); font-size: 1.05rem; font-weight: 600; margin: 0; }
  .cartao-autor-cargo { font-size: .78rem; color: var(--muted); margin: .15rem 0 0; }
  .cartao-autor-legenda { font-size: .85rem; color: var(--ink-2); margin: .5rem 0 0; line-height: 1.45; }

  .pergunta-retorno {
    border-left: 2px solid var(--accent);
    padding: .1rem 0 .1rem 1rem;
    margin-bottom: 1.1rem;
  }
  .pergunta-retorno:last-of-type { margin-bottom: 0; }
  .pergunta-frente {
    font-size: .7rem; font-weight: 600; letter-spacing: .08em;
    text-transform: uppercase; color: var(--muted); margin: 0 0 .3rem;
  }
  .pergunta-texto {
    font-family: var(--serif); font-size: 1.05rem; line-height: 1.4;
    color: var(--ink); margin: 0;
  }
</style>

<script define:vars={{ agenda: SITE.contato.agenda, email: SITE.contato.email, temArtigos, perguntas, nomesFrentes }}>
  const form = document.getElementById("form-lead");
  const erro = document.getElementById("erro-form");
  const botao = document.getElementById("btn-enviar");

  const mostrarErro = (texto) => {
    erro.textContent = texto;
    erro.classList.remove("oculto");
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    erro.classList.add("oculto");
    botao.disabled = true;
    botao.textContent = "Enviando…";

    // De onde o visitante veio. Sem isto, "fonte de lead própria" não se mede.
    const params = new URLSearchParams(location.search);
    const rastreio = {
      utmSource: params.get("utm_source") || "",
      utmMedium: params.get("utm_medium") || "",
      utmCampaign: params.get("utm_campaign") || "",
      utmContent: params.get("utm_content") || "",
      referrer: document.referrer || "",
      pagina: location.pathname,
    };

    const dados = {
      rastreio,
      nome: document.getElementById("nome").value,
      email: document.getElementById("email").value,
      telefone: document.getElementById("telefone").value,
      perfil: document.querySelector('input[name="perfil"]:checked')?.value ?? "",
      patrimonio: document.getElementById("patrimonio").value,
      prazo: document.getElementById("prazo").value,
      dimensoes: [...document.querySelectorAll('input[name="dimensoes"]:checked')].map((c) => c.value),
      contexto: document.getElementById("contexto").value,
      origem: document.getElementById("origem").value,
      website: document.getElementById("website").value,
      consentimento: document.getElementById("consentimento").checked,
    };

    /**
     * Avisa por e-mail via Netlify Forms. É canal paralelo, não o principal:
     * roda sem travar a tela e uma falha aqui nunca quebra o envio do lead.
     */
    const notificar = (faixa, pontuacao) => {
      try {
        const corpo = new URLSearchParams({
          "form-name": "diagnostico",
          nome: dados.nome,
          email: dados.email,
          telefone: dados.telefone,
          perfil: dados.perfil,
          patrimonio: dados.patrimonio,
          prazo: dados.prazo,
          preocupacoes: dados.dimensoes.map((d) => nomesFrentes[d] ?? d).join(", "),
          contexto: dados.contexto,
          origem: [dados.origem, rastreio.utmSource, rastreio.referrer].filter(Boolean).join(" | "),
          faixa: faixa ?? "",
          pontuacao: String(pontuacao ?? ""),
        });
        fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: corpo.toString(),
        }).catch(() => {});
      } catch {
        // Notificação é conveniência. O lead já está gravado.
      }
    };

    try {
      const resposta = await fetch("/api/leads", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(dados),
      });
      const corpo = await resposta.json();
      if (!resposta.ok) throw new Error(corpo.erro || "Não foi possível enviar agora.");

      notificar(corpo.faixa, corpo.pontuacao);

      form.classList.add("oculto");
      const painel = document.getElementById("obrigado");
      painel.classList.remove("oculto");
      document.getElementById("obrigado-titulo").textContent = corpo.titulo;
      document.getElementById("obrigado-msg").textContent = corpo.mensagem;

      // Devolve, para cada frente marcada, a pergunta que abre a conversa.
      const marcadas = dados.dimensoes.filter((d) => perguntas[d]);
      if (marcadas.length) {
        const bloco = document.getElementById("obrigado-perguntas");
        bloco.innerHTML =
          '<p class="olho" style="margin-bottom:1rem">Comece pensando nisto</p>' +
          marcadas
            .map(
              (d) =>
                '<div class="pergunta-retorno">' +
                `<p class="pergunta-frente">${nomesFrentes[d]}</p>` +
                `<p class="pergunta-texto">${perguntas[d]}</p>` +
                "</div>"
            )
            .join("") +
          '<p class="nota" style="margin-top:1rem">' +
          (marcadas.length === 1 ? "É a pergunta" : "São as perguntas") +
          " por onde eu começaria na nossa conversa. Não precisa ter a resposta agora.</p>";
        bloco.classList.remove("oculto");
      }

      const acoes = document.getElementById("obrigado-acoes");
      const botoes = [];
      if (corpo.proximoPasso === "agenda") {
        if (agenda) {
          botoes.push(`<a class="btn btn-primario" href="${agenda}" target="_blank" rel="noopener">Escolher um horário</a>`);
        } else if (email) {
          // Sem agenda pública, o lead prioritário ainda sai daqui com um caminho.
          const assunto = encodeURIComponent("Diagnóstico patrimonial: " + dados.nome);
          botoes.push(`<a class="btn btn-primario" href="mailto:${email}?subject=${assunto}">Falar por e-mail agora</a>`);
        }
      }
      botoes.push('<a class="btn btn-secundario" href="/calculadoras">Ver as calculadoras</a>');
      if (temArtigos) botoes.push('<a class="btn btn-secundario" href="/artigos">Ler os artigos</a>');
      acoes.innerHTML = botoes.join("");
      painel.scrollIntoView({ behavior: "smooth", block: "start" });
    } catch (erroEnvio) {
      mostrarErro(erroEnvio.message);
      botao.disabled = false;
      botao.textContent = "Enviar";
    }
  });
</script>
