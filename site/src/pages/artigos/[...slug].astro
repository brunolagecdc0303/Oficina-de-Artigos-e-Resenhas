---
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { DIMENSOES, porSlug } from "../../lib/calculadoras.js";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const artigos = await getCollection("artigos");
  return artigos
    .filter((a) => !a.data.rascunho)
    .map((artigo) => ({ params: { slug: artigo.id }, props: { artigo } }));
}

const { artigo } = Astro.props;
const { Content } = await render(artigo);
const dim = DIMENSOES[artigo.data.dimensao];
const calc = artigo.data.calculadora ? porSlug(artigo.data.calculadora) : null;
const formata = (d) =>
  d.toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric" });
const palavras = (artigo.body ?? "").split(/\s+/).filter(Boolean).length;
const minutos = Math.max(1, Math.round(palavras / 220));
---
<Base titulo={artigo.data.titulo} descricao={artigo.data.resumo} tipo="article">
  <article class="secao">
    <div class="wrap wrap-estreito">
      <p class="pequeno" style="margin-bottom:1.5rem">
        <a href="/artigos" style="color:var(--muted);text-decoration:none">← Artigos</a>
      </p>
      <p class="etiqueta" style={`--dim: var(--${dim.cor});margin-bottom:1rem`}>{dim.nome}</p>
      <h1>{artigo.data.titulo}</h1>
      <p class="lead">{artigo.data.resumo}</p>
      <p class="nota" style="margin:1.5rem 0 0;border-top:1px solid var(--line);padding-top:1rem">
        {formata(artigo.data.data)} · {minutos} min de leitura
        {artigo.data.revisadoEm && <> · revisado em {formata(artigo.data.revisadoEm)}</>}
      </p>
    </div>

    <div class="wrap wrap-estreito prosa" style="margin-top:2.5rem">
      <Content />
    </div>

    {calc && (
      <div class="wrap wrap-estreito" style="margin-top:3rem">
        <div class="cartao" style="display:flex;gap:1.25rem;align-items:center;flex-wrap:wrap;justify-content:space-between">
          <div>
            <p class="olho" style="margin-bottom:.5rem">Faça a conta</p>
            <p style="margin:0;font-family:var(--serif);font-size:1.15rem">{calc.pergunta}</p>
          </div>
          <a class="btn btn-primario" href={`/calculadoras/${calc.slug}`}>Abrir a calculadora</a>
        </div>
      </div>
    )}
  </article>

  <Cta />
</Base>
