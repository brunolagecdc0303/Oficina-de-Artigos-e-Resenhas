---
import Base from "./Base.astro";
import Aviso from "../components/Aviso.astro";
import { porSlug, DIMENSOES, liberadasPorPadrao } from "../lib/calculadoras.js";
import { SITE } from "../lib/site.js";

const { slug, vigencia } = Astro.props;
const calc = porSlug(slug);
if (!calc) throw new Error(`Calculadora desconhecida no catálogo: ${slug}`);
const dim = DIMENSOES[calc.dimensao];
const liberadaNoBuild = liberadasPorPadrao().includes(slug);
---
<Base titulo={`${calc.nome}: calculadora`} descricao={calc.resumo}>
  <section class="secao" style="padding-bottom:2rem">
    <div class="wrap">
      <p class="pequeno" style="margin-bottom:1.5rem">
        <a href="/calculadoras" style="color:var(--muted);text-decoration:none">← Calculadoras</a>
      </p>
      <div style="max-width:60ch">
        <p class="etiqueta" style={`--dim: var(--${dim.cor});margin-bottom:1rem`}>{dim.nome}</p>
        <h1>{calc.pergunta}</h1>
        <p class="lead">{calc.resumo}</p>
      </div>
    </div>
  </section>

  <section style="padding-bottom:4rem">
    <div class="wrap">
      <div id="calc-area" class="gate" data-slug={slug} data-liberada={liberadaNoBuild ? "" : undefined}>
        <div id="calc-conteudo" class={liberadaNoBuild ? "" : "gate-borrado"} style="padding:1.5rem 0">
          <div class="calc">
            <div class="calc-entradas">
              <slot name="entradas" />
            </div>
            <div class="calc-saida">
              <slot name="saida" />
              <Aviso vigencia={vigencia} />
            </div>
          </div>
        </div>

        <div id="calc-gate" class={liberadaNoBuild ? "gate-capa oculto" : "gate-capa"}>
          <div class="gate-cadeado" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" />
            </svg>
          </div>
          <p class="gate-titulo">Esta calculadora é dos clientes</p>
          <p class="gate-texto">
            Faça o diagnóstico para começar a conversa, ou entre com seu código
            de acesso se você já é cliente.
          </p>
          <p style="display:flex;gap:.5rem;justify-content:center;flex-wrap:wrap;margin:.4rem 0 0">
            <a class="btn btn-primario pequeno" href="/diagnostico">Fazer o diagnóstico</a>
            <a class="btn btn-secundario pequeno" href="/calculadoras#codigo">Tenho um código</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <slot name="depois" />
</Base>

<script>
  import { carregarLiberadas, cacheLiberadas } from "../lib/acesso.js";
  import { liberadasPorPadrao } from "../lib/calculadoras.js";

  const area = document.getElementById("calc-area");
  const conteudo = document.getElementById("calc-conteudo");
  const capa = document.getElementById("calc-gate");
  const slug = area?.dataset.slug;

  const aplicar = ({ liberadas }) => {
    const liberada = liberadas.includes(slug);
    conteudo.classList.toggle("gate-borrado", !liberada);
    capa.classList.toggle("oculto", liberada);
    conteudo.inert = !liberada;
    if (liberada) area.setAttribute("data-liberada", "");
    else area.removeAttribute("data-liberada");
  };

  const cache = cacheLiberadas();
  if (cache) aplicar(cache);
  carregarLiberadas(liberadasPorPadrao()).then(aplicar);
</script>
